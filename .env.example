# Optional public LIFF ID for the staff attendance screen and its entry page.
# Use a separate LIFF app in the SAME LINE Login channel for an isolated Preview.
# Leave unset in Production. Manager/onboarding LIFF routes keep their own configuration.
NEXT_PUBLIC_ATTENDANCE_LIFF_ID=

# Optional public LIFF ID for manager attendance checks in an isolated Preview.
# Same LINE Login channel; endpoint: the Preview URL followed by /manager.
# Applies only to the manager dashboard, individual attendance and correction screens.
# When set, the dashboard hides other feature links and disables sharing.
# Leave unset in Production; other manager/onboarding routes retain their existing IDs.
NEXT_PUBLIC_MANAGER_LIFF_ID=

# Server-only values. Never commit real credentials.
DATABASE_URL=
CRON_SECRET=
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
ONOGAMI_OPERATOR_LINE_USER_IDS=
# Messaging API channel access token. Used server-side to create/link the manager-only rich menu.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# 32 random bytes encoded as base64. Used only server-side for AES-256-GCM QR token encryption.
ONOGAMI_STORE_QR_ENCRYPTION_KEY=

# Preview safety guard. Configure these only for Vercel Preview after assigning
# an isolated Neon branch. The production database hostname is not a secret.
ONOGAMI_PREVIEW_DATABASE_ISOLATED=false
ONOGAMI_PRODUCTION_DATABASE_HOST=

# Keep Preview email disabled unless a safe test recipient/domain is configured.
ONOGAMI_PREVIEW_EMAIL_ENABLED=false
